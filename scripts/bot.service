[Unit]
Description=Huntera Native Go Bot Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/huntera-bot
ExecStart=/home/ubuntu/huntera-bot/huntera-bot-linux
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/huntera-bot/bot.log
StandardError=append:/home/ubuntu/huntera-bot/bot.log

[Install]
WantedBy=multi-user.target
